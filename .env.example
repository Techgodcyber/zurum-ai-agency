# ── Zurum configuration ─────────────────────────────────
# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# Runtime
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
# The public URL of THIS server. Required in production — forms, the admin centre
# and payment webhooks are built from it.
PUBLIC_BASE_URL=

# Control plane. Empty = embedded PGlite (dev only). Set a real Postgres URL in prod.
DATABASE_URL=

# ── AI providers (at least one required) ────────────────
ANTHROPIC_API_KEY=
KIMI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# ── Channels ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Hosting for customer sites ──────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
NETLIFY_TOKEN=

# ── Media ───────────────────────────────────────────────
PEXELS_API_KEY=

# ── Payments ────────────────────────────────────────────
FLUTTERWAVE_SECRET_KEY=
PAYSTACK_SECRET_KEY=
USDT_WALLET_ADDRESS=
# FX rates for charging non-NGN customers in their own currency
FX_API_KEY=

# ── Domains (registrar) ─────────────────────────────────
NAMESILO_API_KEY=

# ── Ops ─────────────────────────────────────────────────
# Chat identities that are unlimited + may run in-chat admin commands
ADMIN_IDENTITIES=

# ── Admin control centre security ───────────────────────
# SECRET path for the admin panel (bots scan /admin). Anything else 404s.
ADMIN_PATH=/console-change-me
# Optional: only these IPs may reach admin (comma-separated). Others get 404.
ADMIN_IP_ALLOWLIST=
# Login lockout (escalating), keyed on both IP and account.
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOCKOUT_MINUTES=15

# webhook (a tunnel in dev, your VPS domain in prod).
# Secret segment in the inbound webhook path (keep it unguessable).

# ── Publish pricing + free-preview protection (live-editable in admin) ──
PUBLISH_PRICE_STATIC_USD=55
PUBLISH_PRICE_DYNAMIC_USD=120
# Unpaid previews carry a "Preview — Built with Zurum" banner (removed on publish).
# Optionally expire them after N hours (0 = never; recoverable on publish).
PREVIEW_EXPIRY_HOURS=0

# ── WhatsApp (Meta Cloud API, direct — no BSP) ──
WHATSAPP_TOKEN=                 # access token from Meta > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=       # from the same page
WHATSAPP_WABA_ID=               # WhatsApp Business Account ID
WHATSAPP_APP_SECRET=            # App Settings > Basic (optional, verifies inbound)
WHATSAPP_VERIFY_TOKEN=zurum-verify  # same value you set in Meta webhook config
WHATSAPP_WEBHOOK_TOKEN=hook     # secret segment in the callback URL path
